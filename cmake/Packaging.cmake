include_guard(GLOBAL)

set(POMINAL_PACKAGE_CONTACT "${PROJECT_NAME} maintainers"
    CACHE STRING "Maintainer recorded in the generated DEB and RPM packages"
)

string(TOLOWER "${CMAKE_SYSTEM_NAME}" POMINAL_PACKAGE_OS)
string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" POMINAL_PACKAGE_ARCH)

set(CPACK_PACKAGE_NAME "${PROJECT_NAME}")
set(CPACK_PACKAGE_VENDOR "${PROJECT_NAME}")
set(CPACK_PACKAGE_CONTACT "${POMINAL_PACKAGE_CONTACT}")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "${PROJECT_DESCRIPTION}")
set(CPACK_PACKAGE_DESCRIPTION
    "A Pomodoro timer for the terminal. A background daemon keeps time while the pominal command controls it from any terminal session over a Unix domain socket."
)
set(CPACK_PACKAGE_FILE_NAME "${PROJECT_NAME}-${PROJECT_VERSION}-${POMINAL_PACKAGE_OS}-${POMINAL_PACKAGE_ARCH}")
set(CPACK_GENERATOR TGZ)
set(CPACK_STRIP_FILES ON)

set(CPACK_DEBIAN_FILE_NAME DEB-DEFAULT)
set(CPACK_DEBIAN_PACKAGE_SECTION utils)
if(POMINAL_PACKAGE_ARCH STREQUAL "x86_64")
    set(CPACK_DEBIAN_PACKAGE_ARCHITECTURE amd64)
elseif(POMINAL_PACKAGE_ARCH MATCHES "^(aarch64|arm64)$")
    set(CPACK_DEBIAN_PACKAGE_ARCHITECTURE arm64)
else()
    set(CPACK_DEBIAN_PACKAGE_ARCHITECTURE "${POMINAL_PACKAGE_ARCH}")
endif()

set(CPACK_RPM_FILE_NAME RPM-DEFAULT)
set(CPACK_RPM_PACKAGE_LICENSE MIT)
set(CPACK_RPM_COMPRESSION_TYPE xz)
set(CPACK_RPM_PACKAGE_DESCRIPTION "${CPACK_PACKAGE_DESCRIPTION}")

include(CPack)
